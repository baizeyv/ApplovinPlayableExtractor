{
	"name": "applovin-playable-extractor",
	"version": "1.0.0",
	"private": true,
	"type": "commonjs",
	"main": "electron/main.js",
	"scripts": {
		"start": "electron .",
		"start:web": "node server.js",
		"dist:win": "electron-builder --win portable"
	},
	"devDependencies": {
		"electron": "^31.7.7",
		"electron-builder": "^24.13.3"
	},
	"build": {
		"appId": "com.local.applovin-playable-extractor",
		"productName": "Playable Media Extractor",
		"asar": true,
		"files": [
			"electron/**/*",
			"public/**/*",
			"server.js",
			"package.json"
		],
		"win": {
			"target": [
				"portable"
			]
		},
		"portable": {
			"artifactName": "PlayableMediaExtractor.exe"
		}
	}
}
